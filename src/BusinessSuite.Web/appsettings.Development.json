{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=BusinessSuite_Dev;Trusted_Connection=True;MultipleActiveResultSets=False;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  },
  "Email": {
    "PickupDirectory": "App_Data/emails"
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ws: wss:"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  }
}
