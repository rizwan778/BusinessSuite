{
  "Application": {
    "ProductName": "Business Suite",
    "DefaultTimeZone": "Asia/Karachi"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=master;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;Command Timeout=0"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 0,
    "ApplyMigrationsOnStartup": false,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Authentication": {
    "SessionTimeoutMinutes": 480,
    "ApiAccessTokenMinutes": 60,
    "ApiRefreshTokenDays": 14,
    "ApiSessionMaxDays": 30
  },
  "Identity": {
    "Password": {
      "RequiredLength": 12
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00"
    }
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RegistrationPermitLimit": 5,
    "RegistrationWindowSeconds": 900
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*"
}
