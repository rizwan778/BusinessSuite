@model ProductListViewModel
@{
    ViewData.SetPageTitle("Products");
    ViewData.AddBreadcrumb("Inventory");
    ViewData.AddBreadcrumb("Products");
    var filter = Model.Filter;
    var paged = Model.Products;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Products</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Categories</a>
        <a asp-controller="Attributes" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-sliders me-1" aria-hidden="true"></i>Attributes</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New product</a>
    </div>
</div>

<form method="get" class="card card-body border-0 shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small" for="Search">Search name, SKU or barcode</label>
            <input id="Search" name="Search" value="@filter.Search" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="CategoryId">Category</label>
            <select id="CategoryId" name="CategoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var option in Model.CategoryOptions)
                {
                    <option value="@option.Value" selected="@(option.Value == filter.CategoryId?.ToString())">@option.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small" for="Status">Status</label>
            <select id="Status" name="Status" class="form-select">
                <option value="">All</option>
                <option value="active" selected="@(filter.Status == "active")">Active</option>
                <option value="inactive" selected="@(filter.Status == "inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th><th>SKU</th><th>Category</th><th class="text-end">Price</th><th class="text-end">In stock</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in paged.Items)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@product.Id" class="fw-semibold text-decoration-none">@product.Name</a>
                            @if (product.HasVariants)
                            {
                                <span class="badge text-bg-light ms-1">@product.VariantCount variants</span>
                            }
                        </td>
                        <td><code>@product.Sku</code>@if (!string.IsNullOrEmpty(product.Barcode)) { <div class="small text-body-secondary">@product.Barcode</div> }</td>
                        <td>@(product.CategoryName ?? "—")</td>
                        <td class="text-end">@(product.SalePrice?.ToString("N2") ?? "—")</td>
                        <td class="text-end">@(product.TracksStock ? $"{product.StockOnHand:0.####} {product.BaseUnitCode}" : "—")</td>
                        <td><span class="badge @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">@(product.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                }
                @if (paged.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-body-secondary py-4">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (paged.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
            <span class="small text-body-secondary">@paged.TotalCount products · page @paged.Page of @paged.TotalPages</span>
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary @(paged.HasPreviousPage ? null : "disabled")" asp-action="Index"
                   asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-status="@filter.Status" asp-route-page="@(paged.Page - 1)">Previous</a>
                <a class="btn btn-sm btn-outline-secondary @(paged.HasNextPage ? null : "disabled")" asp-action="Index"
                   asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-status="@filter.Status" asp-route-page="@(paged.Page + 1)">Next</a>
            </div>
        </div>
    }
</div>
