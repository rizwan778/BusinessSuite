@model CategoryFormModel
@{
    ViewData.SetPageTitle(Model.IsEdit ? "Edit category" : "New category");
    ViewData.AddBreadcrumb("Products", Url.Action("Index", "Products"));
    ViewData.AddBreadcrumb("Categories", Url.Action("Index", "Categories"));
    ViewData.AddBreadcrumb(Model.IsEdit ? "Edit" : "New");
}

<h1 class="h4 mb-3">@(Model.IsEdit ? "Edit category" : "New category")</h1>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate data-disable-on-submit class="card card-body border-0 shadow-sm">
    <partial name="_FormErrors" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label><input asp-for="Name" class="form-control" /></div>
        <div class="col-md-6">
            <label asp-for="ParentCategoryId" class="form-label">Parent category</label>
            <select asp-for="ParentCategoryId" class="form-select" asp-items="Model.ParentOptions"><option value="">None (top level)</option></select>
        </div>
        <div class="col-md-6"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" type="number" class="form-control" /></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
