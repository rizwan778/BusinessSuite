@model IReadOnlyList<CategoryNode>
@{
    ViewData.SetPageTitle("Categories");
    ViewData.AddBreadcrumb("Products", Url.Action("Index", "Products"));
    ViewData.AddBreadcrumb("Categories");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Categories</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New category</a>
</div>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-body-secondary">No categories yet.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var node in Model)
            {
                <partial name="_CategoryNode" model="node" />
            }
        </ul>
    }
</div>
