@{
    Layout = "/Views/Shared/_Layout.cshtml";
    if (string.IsNullOrEmpty(ViewData.GetPageTitle()))
    {
        ViewData.SetPageTitle("Suppliers");
    }

    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var reportsTab = current == "Reports";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Suppliers</h1>
        <p class="text-body-secondary small mb-0">Supplier profiles, purchase history and payables.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New supplier</a>
</div>

<div class="alert alert-warning py-2 small d-flex gap-2" role="note">
    <i class="bi bi-info-circle mt-1" aria-hidden="true"></i>
    <div><strong>Preview.</strong> The suppliers backend is not built yet: suppliers and purchases are kept in memory (lost on restart).
        Payments are not recorded yet, so outstanding balances equal the purchase totals.</div>
</div>

<ul class="section-tabs">
    <li><a class="section-tab @(reportsTab ? null : "active")" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck me-1" aria-hidden="true"></i>Suppliers</a></li>
    <li><a class="section-tab @(reportsTab ? "active" : null)" asp-controller="Suppliers" asp-action="Reports"><i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>Reports</a></li>
</ul>

@RenderBody()
