@model SupplierFormModel
@{ ViewData.SetPageTitle(Model.IsEdit ? "Edit supplier" : "New supplier"); }
<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate data-disable-on-submit class="card card-body border-0 shadow-sm">
    <h2 class="h5">@(Model.IsEdit ? "Edit supplier" : "New supplier")</h2>
    <partial name="_FormErrors" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label">Supplier name <span class="text-danger">*</span></label><input asp-for="Name" class="form-control" maxlength="200" /></div>
        <div class="col-md-6"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" maxlength="200" /></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" maxlength="50" /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" type="email" class="form-control" maxlength="200" /></div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2" maxlength="500"></textarea></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary">Save</button><a asp-action="@(Model.IsEdit ? "Details" : "Index")" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div>
</form>
