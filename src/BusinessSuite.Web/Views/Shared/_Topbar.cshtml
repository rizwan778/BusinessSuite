@inject ICurrentUser CurrentUser
@inject IWebHostEnvironment HostEnvironment
@{
    var displayName = CurrentUser.DisplayName ?? CurrentUser.UserName ?? "Account";
    var initial = displayName.Length > 0 ? char.ToUpperInvariant(displayName[0]).ToString() : "?";
}
<header class="app-topbar">
    <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open menu">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    @* Organization and branch switching arrives with multi-tenancy (Phase 2).
       The selection will be validated on the server against the user's memberships. *@
    <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm app-org-switcher" type="button" disabled
                title="Organizations and branches arrive in Phase 2">
            <i class="bi bi-building me-1" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">No organization</span>
            <span class="badge text-bg-light ms-1">Phase 2</span>
        </button>
    </div>

    <div class="ms-auto d-flex align-items-center gap-2">
        @if (!HostEnvironment.IsProduction())
        {
            <span class="badge rounded-pill text-bg-warning app-env-badge" title="Current environment">
                <i class="bi bi-cone-striped me-1" aria-hidden="true"></i>@HostEnvironment.EnvironmentName
            </span>
        }

        <div class="dropdown">
            <button class="btn btn-link app-user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="app-avatar" aria-hidden="true">@initial</span>
                <span class="d-none d-md-inline">@displayName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li>
                    <span class="dropdown-item-text small text-body-secondary">Signed in as<br /><strong>@CurrentUser.UserName</strong></span>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
