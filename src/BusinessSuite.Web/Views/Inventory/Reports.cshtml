@model ReportViewModel
@{
    ViewData.SetPageTitle("Inventory reports");
    var title = ReportTypes.All.First(report => report.Key == Model.Type).Title;
    var filtered = Model.Type is ReportTypes.Product or ReportTypes.LowStock or ReportTypes.OutOfStock or ReportTypes.Movements;
}

<ul class="section-tabs">
    @foreach (var report in ReportTypes.All)
    {
        <li><a class="section-tab @(report.Key == Model.Type ? "active" : null)" asp-action="Reports" asp-route-type="@report.Key">@report.Title</a></li>
    }
</ul>

<form method="get" class="card card-body border-0 shadow-sm mb-3">
    <input type="hidden" name="type" value="@Model.Type" />
    <div class="row g-2 align-items-end">
        @if (filtered)
        {
            <div class="col-md-3"><label class="form-label small" for="search">@(Model.Type == ReportTypes.Movements ? "SKU" : "Search")</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div>
        }
        @if (Model.Type is not (ReportTypes.Warehouse or ReportTypes.Summary or ReportTypes.Expiry))
        {
            <div class="col-md-3"><label class="form-label small" for="warehouseId">Warehouse</label>
                <select id="warehouseId" name="warehouseId" class="form-select"><option value="">All</option>
                    @foreach (var option in Model.Warehouses) { <option value="@option.Value" selected="@(option.Value == Model.WarehouseId?.ToString())">@option.Text</option> }</select></div>
        }
        @if (Model.Type == ReportTypes.Movements)
        {
            <div class="col-md-2"><label class="form-label small" for="from">From</label><input id="from" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label small" for="to">To</label><input id="to" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
        }
        @if (Model.Type == ReportTypes.Expiry)
        {
            <div class="col-md-3"><label class="form-label small" for="days">Expiring within (days)</label><input id="days" name="days" type="number" min="1" value="@Model.Days" class="form-control" /></div>
        }
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Run</button></div>
    </div>
</form>

<h2 class="h5 mb-3">@title</h2>

@if (Model.Dashboard is { } dashboard)
{
    <div class="row g-3 mb-3">
        @foreach (var tile in new[]
        {
            ("Products", $"{dashboard.ActiveProducts} active of {dashboard.TotalProducts}"),
            ("Variants", dashboard.TotalVariants.ToString()),
            ("Warehouses", dashboard.TotalWarehouses.ToString()),
            ("Inventory value", dashboard.InventoryValue.ToString("N2")),
            ("Low stock", dashboard.LowStockCount.ToString()),
            ("Out of stock", dashboard.OutOfStockCount.ToString()),
            ("Near expiry batches", $"{dashboard.NearExpiryBatchCount} (within {dashboard.NearExpiryDays} days)"),
            ("Expired batches", dashboard.ExpiredBatchCount.ToString()),
        })
        {
            <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-body-secondary">@tile.Item1</div><div class="h5 mb-0">@tile.Item2</div></div></div></div>
        }
    </div>
    <div class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h3 class="h6 mb-0">Recent movements</h3></div><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>When (UTC)</th><th>Type</th><th>Product</th><th>Warehouse</th><th class="text-end">Quantity</th></tr></thead>
            <tbody>
                @foreach (var movement in dashboard.RecentMovements)
                {
                    <tr><td>@movement.OccurredAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td><td>@movement.Type</td><td>@movement.ProductName</td><td>@movement.WarehouseName</td>
                        <td class="text-end">@(movement.Quantity > 0 ? "+" : "")@movement.Quantity.ToString("0.####")</td></tr>
                }
                @if (dashboard.RecentMovements.Count == 0) { <tr><td colspan="5" class="text-center text-body-secondary py-3">No movements yet.</td></tr> }
            </tbody>
        </table>
    </div></div>
}

@if (Model.ByWarehouse is { } perWarehouse)
{
    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Warehouse</th><th class="text-end">Stock lines</th><th class="text-end">On hand</th><th class="text-end">Reserved</th><th class="text-end">Value</th></tr></thead>
            <tbody>
                @foreach (var warehouse in perWarehouse)
                {
                    <tr><td>@warehouse.Name <code>@warehouse.Code</code>@if (!warehouse.IsActive) { <span class="badge text-bg-secondary ms-1">Inactive</span> }</td>
                        <td class="text-end">@warehouse.StockLineCount</td><td class="text-end">@warehouse.QuantityOnHand.ToString("0.####")</td><td class="text-end">@warehouse.Reserved.ToString("0.####")</td><td class="text-end">@warehouse.Value.ToString("N2")</td></tr>
                }
                @if (perWarehouse.Count == 0) { <tr><td colspan="5" class="text-center text-body-secondary py-3">No warehouses.</td></tr> }
            </tbody>
        </table>
    </div></div>
}

@if (Model.Valuation is { } valuation)
{
    <div class="row g-3 mb-3">
        <div class="col-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-body-secondary">Total value</div><div class="h4 mb-0">@valuation.TotalValue.ToString("N2")</div></div></div></div>
        <div class="col-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-body-secondary">Total quantity</div><div class="h4 mb-0">@valuation.TotalQuantity.ToString("0.####")</div></div></div></div>
    </div>
    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Warehouse</th><th class="text-end">On hand</th><th class="text-end">Value</th></tr></thead>
            <tbody>
                @foreach (var warehouse in valuation.ByWarehouse)
                {
                    <tr><td>@warehouse.Name</td><td class="text-end">@warehouse.QuantityOnHand.ToString("0.####")</td><td class="text-end">@warehouse.Value.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div></div>
}

@if (Model.Items is { } items)
{
    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Product</th><th>SKU</th><th class="text-end">Reorder level</th><th class="text-end">On hand</th><th class="text-end">Available</th><th class="text-end">Value</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var item in items.Items)
                {
                    <tr><td>@item.Name</td><td><code>@item.Sku</code></td><td class="text-end">@(item.ReorderLevel?.ToString("0.####") ?? "—")</td>
                        <td class="text-end">@item.OnHand.ToString("0.####") @item.UnitCode</td><td class="text-end">@item.Available.ToString("0.####")</td><td class="text-end">@item.Value.ToString("N2")</td>
                        <td><span class="badge @(item.IsOutOfStock ? "text-bg-danger" : item.IsLowStock ? "text-bg-warning" : "text-bg-success")">@(item.IsOutOfStock ? "Out of stock" : item.IsLowStock ? "Low stock" : "In stock")</span></td></tr>
                }
                @if (items.Items.Count == 0) { <tr><td colspan="7" class="text-center text-body-secondary py-3">Nothing to show.</td></tr> }
            </tbody>
        </table>
    </div></div>
    <partial name="_Pager" model="PagerModel.From(items)" />
}

@if (Model.Movements is { } movements)
{
    <partial name="_MovementsTable" model="movements" />
}

@if (Model.Batches is { } batches)
{
    <partial name="_BatchesTable" model="batches" />
}
