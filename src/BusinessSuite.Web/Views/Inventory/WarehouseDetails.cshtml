@model WarehouseDetailsViewModel
@{ var warehouse = Model.Warehouse; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">@warehouse.Name
            <span class="badge @(warehouse.IsActive ? "text-bg-success" : "text-bg-secondary") align-middle">@(warehouse.IsActive ? "Active" : "Inactive")</span>
            @if (warehouse.IsDefault) { <span class="badge text-bg-primary align-middle">Default</span> }</h2>
        <div class="small text-body-secondary"><code>@warehouse.Code</code> · @(warehouse.Address ?? "No address") · @warehouse.StockLineCount stock lines · value @warehouse.StockValue.ToString("N2")</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="EditWarehouse" asp-route-id="@warehouse.Id" class="btn btn-primary">Edit</a>
        @if (!warehouse.IsDefault && warehouse.IsActive)
        {
            <form asp-action="SetDefaultWarehouse" asp-route-id="@warehouse.Id" method="post"><button class="btn btn-outline-primary" type="submit">Make default</button></form>
        }
        <form asp-action="SetWarehouseStatus" asp-route-id="@warehouse.Id" method="post">
            <input type="hidden" name="isActive" value="@((!warehouse.IsActive).ToString().ToLowerInvariant())" />
            <button class="btn @(warehouse.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(warehouse.IsActive ? "Deactivate" : "Activate")</button>
        </form>
    </div>
</div>
<div class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h3 class="h6 mb-0">Stock in this warehouse</h3></div><div class="table-responsive">
    <table class="table align-middle mb-0">
        <thead><tr><th>Product</th><th>SKU</th><th>Batch</th><th class="text-end">On hand</th><th class="text-end">Available</th><th class="text-end">Value</th></tr></thead>
        <tbody>
            @foreach (var balance in Model.Stock.Items)
            {
                <tr><td>@balance.ProductName</td><td><code>@(balance.VariantSku ?? balance.Sku)</code></td><td>@(balance.BatchNumber ?? "—")</td>
                    <td class="text-end">@balance.OnHand.ToString("0.####") @balance.UnitCode</td><td class="text-end">@balance.Available.ToString("0.####")</td><td class="text-end">@balance.Value.ToString("N2")</td></tr>
            }
            @if (Model.Stock.Items.Count == 0) { <tr><td colspan="6" class="text-center text-body-secondary py-3">This warehouse holds no stock.</td></tr> }
        </tbody>
    </table>
</div></div>
<partial name="_Pager" model="PagerModel.From(Model.Stock)" />
