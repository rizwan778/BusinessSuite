@model StockTransferDetails
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Transfer @Model.Number <span class="badge @(Model.Status == StockTransferStatus.Received ? "text-bg-success" : Model.Status == StockTransferStatus.Cancelled ? "text-bg-secondary" : "text-bg-warning") align-middle">@Model.Status</span></h2>
        <div class="small text-body-secondary">@Model.FromWarehouseName → @Model.ToWarehouseName · @Model.TransferDate.ToString("d")@(string.IsNullOrEmpty(Model.Notes) ? "" : " · " + Model.Notes)</div>
    </div>
    @if (Model.Status == StockTransferStatus.Draft)
    {
        <div class="d-flex gap-2">
            <form asp-action="PostTransfer" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" type="submit">Post</button></form>
            <form asp-action="CancelTransfer" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger" type="submit">Cancel</button></form>
        </div>
    }
</div>
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table align-middle mb-0">
        <thead><tr><th>Product</th><th>SKU</th><th>Batch</th><th class="text-end">Quantity</th><th class="text-end">Received</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td>@item.ProductName</td><td><code>@(item.VariantSku ?? item.Sku)</code></td><td>@(item.BatchNumber ?? "—")</td>
                    <td class="text-end">@item.Quantity.ToString("0.####")</td><td class="text-end">@(item.ReceivedQuantity?.ToString("0.####") ?? "—")</td></tr>
            }
        </tbody>
    </table>
</div></div>
