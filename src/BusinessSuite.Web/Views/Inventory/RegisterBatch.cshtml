@model BatchFormModel
@{ ViewData.SetPageTitle("Register batch"); }
<form asp-action="RegisterBatch" method="post" novalidate data-disable-on-submit class="card card-body border-0 shadow-sm">
    <h2 class="h5">Register batch</h2>
    <partial name="_FormErrors" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Sku" class="form-label">SKU (product or variant) <span class="text-danger">*</span></label><input asp-for="Sku" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="BatchNumber" class="form-label">Batch number <span class="text-danger">*</span></label><input asp-for="BatchNumber" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="ManufactureDate" class="form-label">Manufacturing date</label><input asp-for="ManufactureDate" type="date" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="ExpiryDate" class="form-label">Expiry date</label><input asp-for="ExpiryDate" type="date" class="form-control" /></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary">Register</button><a asp-action="Batches" class="btn btn-outline-secondary">Cancel</a></div>
</form>
