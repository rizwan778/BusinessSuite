@model PagedResult<StockMovementDetails>
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>When (UTC)</th><th>Type</th><th>Product</th><th>Warehouse</th><th>Batch</th><th class="text-end">Quantity</th><th class="text-end">Balance after</th><th>Reference</th></tr></thead>
        <tbody>
            @foreach (var movement in Model.Items)
            {
                <tr>
                    <td class="text-nowrap">@movement.OccurredAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@movement.Type</td>
                    <td>@movement.ProductName <code>@(movement.VariantSku ?? movement.Sku)</code></td>
                    <td>@movement.WarehouseName</td><td>@(movement.BatchNumber ?? "—")</td>
                    <td class="text-end @(movement.Quantity < 0 ? "text-danger" : "text-success")">@(movement.Quantity > 0 ? "+" : "")@movement.Quantity.ToString("0.####")</td>
                    <td class="text-end">@movement.QuantityAfter.ToString("0.####")</td>
                    <td>@(movement.Reference ?? movement.SourceType)</td>
                </tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-center text-body-secondary py-4">No movements found.</td></tr> }
        </tbody>
    </table>
</div></div>
<partial name="_Pager" model="PagerModel.From(Model)" />
