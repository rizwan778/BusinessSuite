@model WarehouseFormModel
@{ ViewData.SetPageTitle(Model.IsEdit ? "Edit warehouse" : "New warehouse"); }
<form asp-action="@(Model.IsEdit ? "EditWarehouse" : "CreateWarehouse")" asp-route-id="@Model.Id" method="post" novalidate data-disable-on-submit class="card card-body border-0 shadow-sm">
    <h2 class="h5">@(Model.IsEdit ? "Edit warehouse" : "New warehouse")</h2>
    <partial name="_FormErrors" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label><input asp-for="Name" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Code" class="form-label">Code <span class="text-danger">*</span></label><input asp-for="Code" class="form-control" /></div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div>
        <div class="col-12"><div class="form-check"><input asp-for="MakeDefault" class="form-check-input" /><label asp-for="MakeDefault" class="form-check-label">Make this the default warehouse</label></div></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary">Save</button><a asp-action="Warehouses" class="btn btn-outline-secondary">Cancel</a></div>
</form>
