@model TransferFormModel
@{ ViewData.SetPageTitle("New stock transfer"); }
<form asp-action="CreateTransfer" method="post" novalidate data-disable-on-submit>
    <partial name="_FormErrors" />
    <div class="card border-0 shadow-sm mb-3"><div class="card-body">
        <h2 class="h5">New warehouse transfer</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="FromWarehouseId" class="form-label">From warehouse <span class="text-danger">*</span></label>
                <select asp-for="FromWarehouseId" class="form-select" asp-items="Model.Warehouses"><option value="@Guid.Empty">Select…</option></select>
            </div>
            <div class="col-md-4">
                <label asp-for="ToWarehouseId" class="form-label">To warehouse <span class="text-danger">*</span></label>
                <select asp-for="ToWarehouseId" class="form-select" asp-items="Model.Warehouses"><option value="@Guid.Empty">Select…</option></select>
            </div>
            <div class="col-md-4"><label asp-for="TransferDate" class="form-label">Date</label><input asp-for="TransferDate" type="date" class="form-control" /></div>
            <div class="col-12"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" /></div>
        </div>
    </div></div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body">
        <h3 class="h6">Items</h3>
        <partial name="_LineInputs" model="(IReadOnlyList<StockLineInput>)Model.Lines" />
    </div></div>
    <div class="form-check mb-3"><input asp-for="PostNow" class="form-check-input" /><label asp-for="PostNow" class="form-check-label">Post now (moves the stock immediately; otherwise saved as a draft)</label></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save</button><a asp-action="Transfers" class="btn btn-outline-secondary">Cancel</a></div>
</form>
