{
  // F5 in VS Code (C# Dev Kit / C# extension): build, start the web app with the "https"
  // profile from Properties/launchSettings.json, and open the browser.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BusinessSuite.Web (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BusinessSuite.Web/bin/Debug/net10.0/BusinessSuite.Web.dll",
      "cwd": "${workspaceFolder}/src/BusinessSuite.Web",
      "launchSettingsProfile": "https",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)"
      }
    },
    {
      "name": "Attach to a running process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
